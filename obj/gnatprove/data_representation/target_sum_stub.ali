V "GNAT Lib v16"
A -gnatA
A -gnatwa
A -gnat2022
A -gnata
A -gnatR2js
A -gnatws
A -gnatx
A -gnatis
A -mtune=generic
A -march=x86-64
P ZX

RN
RV NO_DIRECT_BOOLEAN_OPERATORS
RV NO_IMPLEMENTATION_ASPECT_SPECIFICATIONS
RV NO_IMPLEMENTATION_PRAGMAS

U target_sum_stub%b	target_sum_stub.adb	a34ecd06 NE OO PK

U target_sum_stub%s	target_sum_stub.ads	73875d01 EE NE OO PK

D system.ads		20260430083320 e2b7c99d system%s
D target_sum_stub.ads	20260918180816 73875d01 target_sum_stub%s
D target_sum_stub.adb	20260918180816 d0c99007 target_sum_stub%b
G a e
G c Z s b [exists target_sum_stub 7 13 none]
G c Z s s [TvaluesBIP target_sum_stub 5 4 none]

